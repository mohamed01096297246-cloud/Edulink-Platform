#!/bin/sh
# The live server deploys whatever reaches main, so the backend's tests run
# here first: if any fails, the push stops and nothing goes live.
# (Set up with: git config core.hooksPath .githooks)
z40=0000000000000000000000000000000000000000
changed=""
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  if git diff --name-only $range 2>/dev/null | grep -q '^backend/'; then changed=1; fi
done
[ -z "$changed" ] && exit 0

echo "pre-push: running backend tests before pushing..."
( cd backend && npm test --silent ) || {
  echo ""
  echo "pre-push: tests FAILED — push stopped, nothing was deployed."
  exit 1
}
echo "pre-push: all tests passed."
